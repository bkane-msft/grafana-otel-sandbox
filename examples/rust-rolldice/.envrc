source_up

export OTEL_RESOURCE_ATTRIBUTES=service.name=rust-rolldice,service.instance.id=127.0.0.1:8081
export OTEL_METRIC_EXPORT_INTERVAL=5000

# Per-signal exporter selection (mirrors Go's autoexport). Each accepts
# otlp (default), console (print to stdout), or none (disable the signal):
# export OTEL_TRACES_EXPORTER=otlp
# export OTEL_METRICS_EXPORTER=otlp
# export OTEL_LOGS_EXPORTER=otlp

# Propagators for distributed trace context (mirrors Go's autoprop). Comma-
# separated; default tracecontext,baggage. Use none to disable propagation:
# export OTEL_PROPAGATORS=tracecontext,baggage

# Both transports are compiled in. Switch these together to use gRPC:
# export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# RUST_LOG takes precedence; LOG_LEVEL is supported as a fallback.
export RUST_LOG=info
