source_up

# 5s instead of the 60s default so metrics show up quickly in dev.
export OTEL_METRIC_EXPORT_INTERVAL=5000
export OTEL_RESOURCE_ATTRIBUTES=service.name=rolldice,service.instance.id=127.0.0.1:8081
# http instead of https — see https://github.com/open-telemetry/opentelemetry-go/issues/4834
# Also the sole control for insecure OTLP log export (otel.go no longer hardcodes it).
export OTEL_EXPORTER_OTLP_INSECURE=true

# Log verbosity for both logging modes below. One of DEBUG, INFO, WARN, ERROR
# (case-insensitive); anything else defaults to INFO.
export LOG_LEVEL=info

# Exporters are selected at runtime via env vars (opentelemetry autoexport).
# Default is otlp for all signals; switch any to stdout for local debugging:
# export OTEL_TRACES_EXPORTER=console
# export OTEL_METRICS_EXPORTER=console
# export OTEL_LOGS_EXPORTER=console
#
# Logs have one extra, non-standard option: "slogtint" writes colorized,
# human-readable logs to stderr (not exported anywhere) — nice for local dev:
# export OTEL_LOGS_EXPORTER=slogtint

# Propagators are selected via env var (opentelemetry autoprop).
# Default is tracecontext,baggage; add others (e.g. b3) here if needed:
# export OTEL_PROPAGATORS=tracecontext,baggage
